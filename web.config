<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appSettings>
    <!--
      Passwort zum Speichern der Einstellungen. Leer = Speichern ist ungeschützt.
      Dringend setzen, falls nicht die Windows-Anmeldung (Block am Ende) genutzt wird.
      Die web.config wird von IIS nie ausgeliefert.
    -->
    <add key="SpeichernPasswort" value="" />
  </appSettings>

  <system.web>
    <!-- Upload-Grenze für speichern.ashx: 50 MB (Bilder stecken in der JSON-Datei) -->
    <httpRuntime maxRequestLength="51200" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
    </staticContent>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>

  <!-- Kachel-Daten nie zwischenspeichern, damit Änderungen sofort sichtbar sind -->
  <location path="daten">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Bilder heißen nach ihrem Inhalt (Prüfsumme), ändern sich also nie: lange zwischenspeichern.
       Direkt aufgerufene Dateien (z. B. SVG) dürfen keine Skripte ausführen. -->
  <location path="daten/bilder">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <add name="Content-Security-Policy" value="default-src 'none'; style-src 'unsafe-inline'; sandbox" />
          <add name="X-Content-Type-Options" value="nosniff" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!--
    ALTERNATIV ZUM PASSWORT: Einstellungen und Speichern auf berechtigte Personen beschränken.
    Voraussetzung: In IIS ist die Rolle "URL-Autorisierung" installiert und für die Site
    "Windows-Authentifizierung" aktiviert. Dann diesen Block einkommentieren und
    Gruppe bzw. Benutzer anpassen.

  <location path="einstellungen.html">
    <system.webServer>
      <security>
        <authorization>
          <remove users="*" roles="" verbs="" />
          <add accessType="Allow" roles="DOMAENE\Webtools-Redaktion" />
        </authorization>
      </security>
    </system.webServer>
  </location>
  <location path="speichern.ashx">
    <system.webServer>
      <security>
        <authorization>
          <remove users="*" roles="" verbs="" />
          <add accessType="Allow" roles="DOMAENE\Webtools-Redaktion" />
        </authorization>
      </security>
    </system.webServer>
  </location>
  -->
</configuration>
